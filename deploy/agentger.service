[Unit]
Description=Agentger Telegram UI for Codex
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=codex
Group=codex
WorkingDirectory=/var/lib/agentger
EnvironmentFile=/etc/agentger.env
ExecStart=/usr/bin/agentger start
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
