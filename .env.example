# Create the bot with @BotFather. Never commit the real token.
TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_ALLOWED_USER_IDS=123456789

DATABASE_PATH=./data/bot.sqlite
ATTACHMENT_DIRECTORY=./data/attachments
TELEGRAM_MAX_ATTACHMENT_BYTES=20971520

# Canonical existing roots, comma-separated. Never use /, /etc, or ~/.ssh.
ALLOWED_PROJECT_ROOTS=/home/codex/projects,/home/codex/src

# alias=absolute-path, comma-separated. These seed/update the projects table.
PROJECTS=frux=/home/codex/projects/frux,backend=/home/codex/src/backend

# New non-reserved Telegram topics start Codex in this project.
# May be omitted only when PROJECTS contains exactly one alias.
DEFAULT_PROJECT=frux

# chat_id:thread_id:purpose, comma-separated. Optional.
RESERVED_TOPICS=-1001234567890:10:daily-report,-1001234567890:20:weekly-report

CODEX_BINARY=/home/codex/.local/bin/codex
CODEX_APPROVAL_POLICY=on-request
CODEX_SANDBOX=workspace-write

RPC_TIMEOUT_MS=30000
APPROVAL_TIMEOUT_MS=600000
STREAM_UPDATE_INTERVAL_MS=750
TELEGRAM_LONG_POLL_SECONDS=45

# Optional custom emoji ID for a ✅ completion reaction. Falls back to 👍.
TELEGRAM_COMPLETION_REACTION_CUSTOM_EMOJI_ID=
